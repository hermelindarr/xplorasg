# ============================================================
# XploraSG Backend — variables de entorno
# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" real a GitHub.
# ============================================================

# Servidor
PORT=4000
NODE_ENV=development

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=xplorasg

# Autenticación JWT
JWT_SECRET=reemplaza_esto_por_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# CORS - dominio del frontend permitido
CORS_ORIGIN=http://localhost:5173

# Almacenamiento de imágenes (Firebase Storage)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Contraseñas de usuarios DEMO (solo para backend/seeds/seedUsers.js)
# IMPORTANTE: si la contraseña incluye "#" u otros caracteres especiales,
# debe ir entre comillas dobles, o dotenv la interpretará como un comentario
# y truncará el valor.
SEED_ADMIN_PASSWORD="Admin#2026"
SEED_PRESTADOR_PASSWORD="Prestador#2026"
SEED_TURISTA_PASSWORD="Turista#2026"
