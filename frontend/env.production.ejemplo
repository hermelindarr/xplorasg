# =============================================================================
# XploraSG - Variables de PRODUCCION del frontend (Vite)
# 1. Copia este archivo en esta misma carpeta (frontend) con el nombre:  .env.production  (con punto al inicio)
# 2. Rellena los valores.
# 3. Recien entonces ejecuta "npm run build".
#
# Vite INCRUSTA estos valores dentro del JavaScript compilado: son PUBLICOS.
# Nunca pongas aqui la service_role de Supabase ni claves de IA u OpenRouteService.
# Si cambias algun valor, tienes que volver a compilar y volver a subir.
# =============================================================================

# URL publica de la API (sin "/" al final y sin "/api"):
#  - Si la API corre en cPanel (subdominio):  https://api.tudominio.com
#  - Si la API sigue en Render:              https://xplorasg-api.onrender.com
VITE_API_URL=https://api.tudominio.com

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave publishable/anon (NUNCA la service_role)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Ya no se usa: sin telefono real del prestador no se muestra el boton de WhatsApp.
VITE_WHATSAPP_RESERVAS=
VITE_CONTACTO_PRIVACIDAD=
VITE_IDLE_TIMEOUT_MIN=15
